# Hermes Music — variables d'environnement
# Copier ce fichier vers .env puis adapter les valeurs.
# NE JAMAIS committer .env (contient des secrets à terme).

# Identité des fichiers sur le NAS (uid/gid de l'utilisateur)
PUID=1002
PGID=10
TZ=Europe/Brussels

# Chemin de la bibliothèque musicale sur le NAS (hôte)
MUSIC_LIBRARY_PATH=~/Music

# Port d'accès local HTTP de Jellyfin
JELLYFIN_PORT=8096

# Jellyfin — clé API (générée via Admin > API Keys) et URL interne
# Utilisée par l'importateur (V0.2) pour déclencher les scans.
JELLYFIN_API_KEY=
JELLYFIN_URL=http://jellyfin:8096

# Spotify — lecture des playlists (métadonnées uniquement, jamais l'audio)
# Créer une app sur developer.spotify.com/dashboard (redirect URI = http://localhost:8080)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080

# --- Réservés pour la suite (V0.7 reverse proxy) ---
# DOMAIN=music.example.com
# CF_API_TOKEN=...              # token Cloudflare pour les certificats (Caddy)
