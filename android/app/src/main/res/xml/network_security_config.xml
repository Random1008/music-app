<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS autorisé partout ; le trafic EN CLAIR n'est permis QUE vers les
     adresses personnelles du serveur, jamais en global.

     L'application utilise https://<nom-tailscale> (Funnel) : aucun besoin de
     cleartext. Les entrées ci-dessous ne servent qu'aux adresses de secours.

     Les IP internes (tailnet, réseau local) ne sont pas écrites ici : elles
     dépendent du réseau de chacun. Pour utiliser une adresse en http://,
     ajoute-la en <domain> dans le bloc ci-dessous. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">dh4300plus-59ae.tailb74e62.ts.net</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
