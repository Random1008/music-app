<!-- HTTPS autorisé partout ; le trafic EN CLAIR n'est permis QUE vers le
     serveur Jellyfin personnel (VPN Netbird / réseau local). Jamais en global. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">100.64.0.0</domain>
        <domain includeSubdomains="true">dh4300plus-59ae.netbird.cloud</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
